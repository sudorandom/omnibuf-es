{
  "name": "@omnibuf/protoc-gen-omnibuf-es",
  "version": "0.1.0",
  "description": "Protobuf compiler plugin generating TypeScript single-pass encoders, switch decoders, and lazy Opaque<T> views for OmniBuf",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "protoc-gen-omnibuf-es": "./dist/bin/protoc-gen-omnibuf-es.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudorandom/omnibuf-es.git",
    "directory": "packages/protoc-gen-omnibuf-es"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin/protoc-gen-omnibuf-es.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@omnibuf/core": "workspace:*"
  }
}
