{
  "name": "@omnibuf/node",
  "version": "0.1.0",
  "description": "OmniBuf for Node.js - Buffer string codecs, stream framing, descriptor loaders, and conformance adapter",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "omnibuf-conformance-es": "./dist/bin/conformance-es.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudorandom/omnibuf-es.git",
    "directory": "packages/omnibuf-node"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin/conformance-es.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@omnibuf/core": "workspace:*"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": ">=1.0.0 || >=2.0.0"
  },
  "peerDependenciesMeta": {
    "@bufbuild/protobuf": {
      "optional": true
    }
  }
}
