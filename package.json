{
  "name": "omnibuf-es",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript implementation of the OmniBuf binary wire format for Node.js and browsers",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "test": "node --import tsx --test packages/*/test/*.test.ts",
    "bench": "node --import tsx benchmarks/bench.ts",
    "typecheck": "pnpm --filter @omnibuf/core run build && pnpm -r run typecheck",
    "lint": "eslint . && pnpm run typecheck",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "conformance": "node scripts/run-conformance.mjs",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.2.0",
    "@eslint/js": "^10.0.1",
    "@msgpack/msgpack": "^3.1.3",
    "@types/node": "^22.10.0",
    "eslint": "^10.13.0",
    "google-protobuf": "^4.0.3",
    "prettier": "^3.9.10",
    "protobufjs": "^8.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=20"
  }
}
